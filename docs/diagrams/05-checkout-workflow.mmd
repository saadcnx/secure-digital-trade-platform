flowchart TD
    START["Checkout request"]
    AUTH{"Demo API key valid?"}
    FRAUD["XGBoost + behavioral risk score"]
    FDEC{"Fraud decision"}
    BLOCKF["Block; do not tokenize"]
    STEP["Return STEP_UP_AUTH_REQUIRED<br/>real OTP/3DS not implemented"]
